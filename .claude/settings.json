{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxfmt\" --no-error-on-unmatched-pattern \"$f\"; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with Oxfmt"
          }
        ]
      }
    ]
  }
}
