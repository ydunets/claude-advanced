# Base URL of the API. Read only on the server (Server Actions, Server
# Components and Route Handlers), so it is not prefixed with NEXT_PUBLIC_ and
# never reaches the browser bundle.
API_URL=http://localhost:4000

# Address of the running web app that the Playwright suite (`test:e2e`) opens.
E2E_BASE_URL=http://localhost:3000

# Largest file the meeting page uploads, in bytes (100 MB). Read on the server and
# passed to the upload form; keep it equal to the API's MAX_FILE_SIZE_BYTES.
MAX_UPLOAD_SIZE_BYTES=104857600
