# HTTP port the API listens on.
PORT=4000

# Connection string for the Postgres service started by `pnpm db:up`.
DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings

# Secret used to sign access tokens. Use a long random value outside development.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds.
JWT_EXPIRES_IN_SECONDS=3600

# Directory for uploaded meeting files, relative to apps/api.
FILES_STORAGE_DIR=storage/meeting-files

# Largest accepted upload in bytes (100 MB).
MAX_FILE_SIZE_BYTES=104857600

# Largest accepted avatar in bytes (5 MB). Avatars are stored in an avatars
# folder inside FILES_STORAGE_DIR.
MAX_AVATAR_SIZE_BYTES=5242880

# Sign-in and password change attempts allowed per account within the window.
AUTH_ATTEMPT_LIMIT=5
# Length of that window in seconds (15 minutes).
AUTH_ATTEMPT_WINDOW_SECONDS=900
